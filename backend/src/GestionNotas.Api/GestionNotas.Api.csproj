<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestionNotas.Application\GestionNotas.Application.csproj" />
    <ProjectReference Include="..\GestionNotas.Infrastructure\GestionNotas.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Dependencia transitiva de Microsoft.AspNetCore.OpenApi. Se fija explícitamente en 2.7.5+
         porque la 2.0.0 tiene GHSA-v5pm-xwqc-g5wc (DoS por referencias circulares al leer documentos OpenAPI). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.0" />
    <!-- Generación de archivos Excel (.xlsx). Licencia MIT. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.*" />
  </ItemGroup>

</Project>
